# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Generated secrets (LiteLLM keys, DEID_MAPPING_KEY, AUDIT_CHAIN_KEY, DB passwords) can be
# filled with `just gen-keys`, which writes them into .env without printing them.
# URLs are host-side; docker-compose overrides them with in-network service names.

# --- LLM providers (free tiers only; reached through the gateway) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama on Windows, as seen from inside the litellm container
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Gateway (LiteLLM proxy) ---
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_APP_KEY=
# Offline batch jobs (e.g. contextual-retrieval prefixes): may call only the local Ollama alias
LITELLM_BATCH_KEY=
# Load tests only (Phase 6): may call the canned mock alias and nothing else
LITELLM_LOAD_KEY=
GATEWAY_URL=http://127.0.0.1:4000

# --- Postgres (databases: clinscribe, litellm, hapi) ---
POSTGRES_USER=clinscribe
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Password of the restricted app login (INSERT/SELECT on the audit table only)
APP_DB_PASSWORD=
# Password of the retention login (retention limits and GDPR erasure, ADR-0022)
RETENTION_DB_PASSWORD=
# Owners of the litellm and hapi databases (one login per service)
LITELLM_DB_PASSWORD=
HAPI_DB_PASSWORD=

# --- FHIR (HAPI + Synthea) ---
FHIR_BASE_URL=http://127.0.0.1:8080/fhir
SYNTHEA_POPULATION=50
SYNTHEA_SEED=42

# --- Privacy and audit ---
DEID_URL=http://127.0.0.1:8001
# Fernet key that encrypts the surrogate mapping
DEID_MAPPING_KEY=
# Lets the API (only) call the de-ID service's /reidentify for the doctor's screen (ADR-0015)
DEID_REIDENTIFY_KEY=
# spaCy model for name/place NER (en_core_web_md: 33 MB; en_core_web_lg can be compared in an eval)
DEID_SPACY_MODEL=en_core_web_md
# Names/places: spacy (default) or tagger, the fine-tuned model (ADR-0014). The tagger needs torch and
# the merged model (finetune/merge.py); with it set these Compose variables in .env too:
#   DEID_TARGET=rag  DEID_IMAGE=clinscribe-python-rag:dev  DEID_MEM_LIMIT=3584m
DEID_NER=spacy
DEID_TAGGER_PATH=data/finetune/deid_ner_tagger
# HMAC key for the audit hash chain
AUDIT_CHAIN_KEY=
# HMAC key that signs a doctor's approval of a clinical write (Phase 3)
APPROVAL_TOKEN_KEY=
# HMAC key for API bearer tokens (user + role); DEV_LOGIN=true enables /v1/dev/login for demo users
AUTH_TOKEN_KEY=
DEV_LOGIN=false

# --- Retrieval (Phase 2, `just up rag`) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Neo4j login is user "neo4j" with this password (drug interaction graph)
NEO4J_PASSWORD=
NEO4J_HTTP_URL=http://127.0.0.1:7474
# pgvector, only for the vector-store comparison (task 11); login "vectors" with this password
PGVECTOR_URL=postgresql://vectors@127.0.0.1:5433/vectors
PGVECTOR_PASSWORD=

# --- Agent tools (Phase 3): MCP servers over streamable HTTP ---
GUIDELINES_MCP_URL=http://127.0.0.1:8010/mcp
DRUGGRAPH_MCP_URL=http://127.0.0.1:8011/mcp
FHIR_MCP_URL=http://127.0.0.1:8012/mcp

# --- Voice (Phase 4): Deepgram STT, Cartesia TTS; LiveKit keys from `just gen-keys` ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lets the voice agent worker ask for a token for the doctor in its room, so voice questions are
# audited as that doctor (ADR-0019); held by the worker and the API only
VOICE_AGENT_KEY=

# --- Observability (Langfuse Cloud, EU region) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Chaos switches are runtime state, not configuration: use `just chaos primary-down on|off`.

# --- Later phases (uncomment when the phase starts; add a Settings field at the same time) ---
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
