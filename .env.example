# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Generated secrets (LiteLLM keys, DEID_MAPPING_KEY, AUDIT_CHAIN_KEY, DB passwords) can be
# filled with `just gen-keys`, which writes them into .env without printing them.
# URLs are host-side; docker-compose overrides them with in-network service names.

# --- LLM providers (free tiers only; reached through the gateway) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama on Windows, as seen from inside the litellm container
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Gateway (LiteLLM proxy) ---
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_APP_KEY=
GATEWAY_URL=http://127.0.0.1:4000

# --- Postgres (databases: clinscribe, litellm, hapi) ---
POSTGRES_USER=clinscribe
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Password of the restricted app login (INSERT/SELECT on the audit table only)
APP_DB_PASSWORD=
# Owners of the litellm and hapi databases (one login per service)
LITELLM_DB_PASSWORD=
HAPI_DB_PASSWORD=

# --- FHIR (HAPI + Synthea) ---
FHIR_BASE_URL=http://127.0.0.1:8080/fhir
SYNTHEA_POPULATION=50
SYNTHEA_SEED=42

# --- Privacy and audit ---
DEID_URL=http://127.0.0.1:8001
# Fernet key that encrypts the surrogate mapping
DEID_MAPPING_KEY=
# spaCy model for name/place NER (en_core_web_md: 33 MB; en_core_web_lg can be compared in an eval)
DEID_SPACY_MODEL=en_core_web_md
# HMAC key for the audit hash chain
AUDIT_CHAIN_KEY=

# --- Retrieval (Phase 2, `just up rag`) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Neo4j login is user "neo4j" with this password (drug interaction graph)
NEO4J_PASSWORD=

# --- Observability (Langfuse Cloud, EU region) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Chaos switches are runtime state, not configuration: use `just chaos primary-down on|off`.

# --- Later phases (uncomment when the phase starts; add a Settings field at the same time) ---
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
